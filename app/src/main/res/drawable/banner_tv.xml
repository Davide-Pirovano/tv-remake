<?xml version="1.0" encoding="utf-8"?>
<!-- Banner for a Live TV app tile (config.xml, app_banners): a magenta field with the Live TV glyph. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#00665e" />
        </shape>
    </item>
    <item android:width="76dp" android:height="76dp" android:gravity="center"
        android:drawable="@drawable/ic_livetv" />
</layer-list>
